@using ASP_NET_Core.Models

@{
    var chartConfiguration = ChartConfiguration.Create();
    var initialSeriesType = chartConfiguration.SeriesTypes[chartConfiguration.Defaults.SeriesTypeIndex];
    var initialTitle = char.ToUpper(initialSeriesType[0]) + initialSeriesType[1..] + " Chart";
}

@(Html.DevExtreme().Toolbar()
    .ID("popup-content-toolbar")
    .OnInitialized("chartToolbar.toolbarOnInitialized")
    .Items(items => {
        items.Add()
            .Location(ToolbarItemLocation.Before)
            .Text(initialTitle)
            .CssClass("chart-title");

        items.Add()
            .Location(ToolbarItemLocation.After)
            .Widget(w => w
                .DropDownButton()
                .Icon("export")
                .Text("Export")
                .Items(items => {
                    items.Add().Icon("image").Text("PNG");
                    items.Add().Icon("pdffile").Text("PDF");
                    items.Add().Icon("jpgfile").Text("JPEG");
                    items.Add().Icon("svgfile").Text("SVG");
                })
                .OnItemClick("chartToolbar.onExportChart")
            );

        items.Add()
            .Location(ToolbarItemLocation.After)
            .Widget(w => w
                .Button()
                .Icon("print")
                .Text("Print")
                .OnClick("chartToolbar.onPrintChart")
            );

        items.Add()
            .Location(ToolbarItemLocation.After)
            .Widget(w => w
                .Button()
                .ElementAttr(new { @id = "settings-button" })
                .Icon("optionsoutline")
                .Text("Settings")
                .Template(@<text>
                    <i class="dx-icon dx-icon-optionsoutline"></i>
                    <span class="dx-button-text">Settings</span>
                    <i class="dx-icon dx-icon-spindown"></i>
                </text>)
                .OnClick("chartToolbar.settingOnClick")
            );
    })
)




