@using ASP_NET_Core.Models

@(Html.DevExtreme().Toolbar()
    .ID("popup-content-toolbar")
    .OnInitialized("toolbarOnInitialized")
    .Items(items => {
        items.Add()
            .Location(ToolbarItemLocation.Before)
            .Text(new JS("chartData.seriesTypes[chartData.defaults.seriesTypeIndex].charAt(0).toUpperCase() + chartData.seriesTypes[chartData.defaults.seriesTypeIndex].slice(1) + ' Chart'"))
            .CssClass("chart-title");

        items.Add()
            .Location(ToolbarItemLocation.After)
            .Widget(w => w
                .DropDownButton()
                .Icon("export")
                .Text("Export")
                .Items(items => {
                    items.Add()
                        .Icon("image")
                        .Text("PNG"); 
                    items.Add()
                        .Icon("pdffile")
                        .Text("PDF"); 
                    items.Add()
                        .Icon("jpgfile")
                        .Text("JPEG");
                    items.Add()
                        .Icon("svgfile")
                        .Text("SVG");
                })
                .OnItemClick("onExportChart") 
            );
                                
        items.Add()
            .Location(ToolbarItemLocation.After)
            .Widget(w => w
                .Button()
                .Icon("print")
                .Text("Print")
                .OnClick("onPrintChart")
            );
                           

        items.Add()
            .Location(ToolbarItemLocation.After)
            .Widget(w => w
                .Button()
                .ElementAttr(new { @id = "settings-button" })
                .Icon("optionsoutline")
                .Text("Settings")
                .Template(new TemplateName("settingButtonTemplate"))
                .OnClick("settingOnClick")
            );
                            
    })
)
