@using ASP_NET_Core.Models

<h2>DevExtreme DataGrid - Chart Integration</h2>

@(Html.DevExtreme().DataGrid<ProductExport>()
    .ID("grid")
    .DataSource(d => d.Mvc().Controller("ProductData").LoadAction("Get").Key("Id"))
    .DataSourceOptions(options => options
        .OnLoadingChanged("onLoadingChanged")
    )
    .ShowBorders(true)
    .ColumnAutoWidth(true)   
    .Selection(s => s.Mode(SelectionMode.Multiple))
    .HeaderFilter(f => f.Visible(true))
    .FilterRow(f => f.Visible(true))
    .Paging(p => p.PageSize(10))
    .Toolbar(t => t.Items(items => {
        items.Add()
            .Name("chart")
            .Widget(w => w.Button()
                .Text("Generate Chart")
                .Icon(new JS("helpers.getIcon('pie', false)"))
                .StylingMode(ButtonStylingMode.Contained)
                .Type(ButtonType.Default)
                .OnClick("chartIntegration.showChartPopup")
            );
    }))
    .OnContextMenuPreparing("onContextMenuPreparing")
    .OnRowClick("onRowClick")
    .Columns(columns => {
        columns.AddFor(m => m.Product).Width(170);
        columns.AddFor(m => m.ExporterRegion).Width(170);
        columns.AddFor(m => m.ExportCategory).Caption("Category").Width(170);
        columns.AddFor(m => m.ExportValue);
        columns.AddFor(m => m.TaxPaid);
        columns.AddFor(m => m.LogisticsCost);
    })
    .RemoteOperations(true)
)

@await Html.PartialAsync("_ChartPopup")

<div id="chart-popup"></div>
<div id="settings-popover"></div>

